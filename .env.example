# No secrets belong in source control. Use Vercel's encrypted project settings.
MONGODB_URI=
MONGODB_DATABASE=climate_lens
# Explicit cloud demonstration mode: versioned TinyDB historical dataset.
# Leave blank for local file mode or when using MONGODB_URI.
STORAGE_BACKEND=
# Used only for local development without MongoDB. Never used on Vercel.
LOCAL_DB_PATH=.data/climate.json
RATE_LIMIT_PER_MINUTE=12
CACHE_TTL_DAYS=30
